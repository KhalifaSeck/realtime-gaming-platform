# ============================================================
# Ingestion service — environment variables (TEMPLATE)
#
# Copie ce fichier en .env et remplis les valeurs.
# .env est gitignoré — ne commit JAMAIS de vrais secrets.
# ============================================================

# ---------- Twitch / IGDB OAuth ----------
# Obtenu depuis https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ---------- Azure ADLS Gen2 ----------
# Valeur depuis :
#   cd infra/terraform/azure
#   terraform output -raw adls_account_name
ADLS_ACCOUNT_NAME=
ADLS_CONTAINER_RAW=raw